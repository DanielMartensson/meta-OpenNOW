From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Watermelon OS <build@watermelon-wine-1a>
Date: Sun, 13 Sep 2026 20:00:00 +0200
Subject: [PATCH] opennow-qt: filter Vulkan device extensions to driver support

requestDeviceExtensions() unconditionally forced the full dmabuf contract
(including VK_EXT_image_drm_format_modifier) into QT_VULKAN_DEVICE_EXTENSIONS.
Embedded drivers such as the STM32MP2 GCNano/Vivante blob do not implement
those extensions, so vkCreateDevice fails and Qt falls back to OpenGL.

Filter the non-promoted extensions to those actually advertised by a
physical device before writing the environment variable. Extensions that
were promoted into Vulkan core (1.1/1.2) are kept unconditionally so the
dmabuf capability contract in enabledImportCapabilities() still sides with
capable drivers. When the full contract is missing, the capability bits
stay zero and the streamer uses its CPU upload path instead of GLES.

Upstream-Status: Inappropriate [OpenNOW-specific build integration]
---
diff --git a/opennow-qt/src/streaming/rendering/LinuxVulkanGraphics.h b/opennow-qt/src/streaming/rendering/LinuxVulkanGraphics.h
index 6faaf0a..30a9e51 100644
--- a/opennow-qt/src/streaming/rendering/LinuxVulkanGraphics.h
+++ b/opennow-qt/src/streaming/rendering/LinuxVulkanGraphics.h
@@ -1,6 +1,7 @@
 #pragma once
 
 #include <QByteArrayList>
+#include <QSet>
 #include <QtGlobal>
 #include <QtGui/qtguiglobal.h>
 
@@ -57,12 +58,74 @@ inline QByteArrayList deviceExtensions()
             "VK_KHR_maintenance1", "VK_EXT_queue_family_foreign"};
 }
 
+inline QByteArrayList vulkanCorePromotedDeviceExtensions()
+{
+    // Extensions promoted into Vulkan core (1.1/1.2). A driver reporting a
+    // matching or newer apiVersion omits these from
+    // vkEnumerateDeviceExtensionProperties even though they remain available,
+    // so they are kept unconditionally: requesting them stays valid and the
+    // dmabuf capability contract below requires them to stay in the requested
+    // list so capable drivers keep the accelerated import path.
+    return {"VK_KHR_external_memory", "VK_KHR_external_memory_fd",
+            "VK_KHR_image_format_list", "VK_KHR_bind_memory2",
+            "VK_KHR_get_memory_requirements2", "VK_KHR_sampler_ycbcr_conversion",
+            "VK_KHR_maintenance1"};
+}
+
+inline QSet<QByteArray> enumeratedDeviceExtensions(QVulkanInstance *probe)
+{
+    QSet<QByteArray> available;
+    auto *functions = probe->functions();
+    uint32_t count = 0;
+    if (functions->vkEnumeratePhysicalDevices(probe->vkInstance(), &count, nullptr) != VK_SUCCESS)
+        return available;
+    QList<VkPhysicalDevice> devices(count);
+    if (functions->vkEnumeratePhysicalDevices(probe->vkInstance(), &count, devices.data()) != VK_SUCCESS)
+        return available;
+    devices.resize(count);
+    for (const auto &physical : devices) {
+        uint32_t extensionCount = 0;
+        if (functions->vkEnumerateDeviceExtensionProperties(physical, nullptr, &extensionCount, nullptr)
+                != VK_SUCCESS)
+            continue;
+        QList<VkExtensionProperties> properties(extensionCount);
+        if (functions->vkEnumerateDeviceExtensionProperties(physical, nullptr, &extensionCount,
+                                                            properties.data()) != VK_SUCCESS)
+            continue;
+        properties.resize(extensionCount);
+        for (const auto &property : properties)
+            available.insert(property.extensionName);
+    }
+    return available;
+}
+
 inline void requestDeviceExtensions()
 {
     QVulkanInstance probe;
     if (probe.supportedApiVersion() < QVersionNumber(1, 1)) return;
     auto requested = qgetenv("QT_VULKAN_DEVICE_EXTENSIONS").split(';');
-    for (const auto &extension : deviceExtensions()) {
+    QByteArrayList preferred = deviceExtensions();
+    if (probe.create()) {
+        // Keep only the extensions the driver actually implements. Embedded
+        // drivers (e.g. the STM32MP2 GCNano/Vivante blob) do not implement
+        // VK_EXT_image_drm_format_modifier and friends, and a device that
+        // cannot enable the full contract previously made Qt fall back to
+        // OpenGL. Filtering the non-promoted extensions to those advertised by
+        // a physical device lets Qt create a Vulkan device; the dmabuf import
+        // capability contract in enabledImportCapabilities() still gates the
+        // accelerated frame path on the complete extension set.
+        const QByteArrayList promoted = vulkanCorePromotedDeviceExtensions();
+        const auto available = enumeratedDeviceExtensions(&probe);
+        if (!available.isEmpty()) {
+            QByteArrayList compatible;
+            for (const auto &extension : preferred) {
+                if (promoted.contains(extension) || available.contains(extension))
+                    compatible.append(extension);
+            }
+            if (!compatible.isEmpty()) preferred = compatible;
+        }
+    }
+    for (const auto &extension : preferred) {
         if (!requested.contains(extension)) requested.append(extension);
     }
     qputenv("QT_VULKAN_DEVICE_EXTENSIONS", requested.join(';'));
