From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Watermelon OS <build@watermelon-wine-1a>
Date: Sat, 12 Sep 2026 21:40:00 +0200
Subject: [PATCH] opennow-qt: consume Yocto-prebuilt Rust artifacts

The Qt client build unconditionally invokes cargo to cross-compile the
OpenNOW Rust core, the license-notice report, the update helper and the
embedded streamer (FFI library + standalone binary).

OpenSTLinux instead builds those artifacts once inside the opennow-runtime
recipe with the cross Rust toolchain (installed in
${libdir}/opennow-native, exported as OPENNOW_PREBUILT_NATIVE_DIR). When that
variable points at the directory, every Rust custom target becomes a pure
bundling/copy step, artifact roots and profiles point at the prebuilt
directory, and the Linux-only VAAPI/V4L2 feature probe is skipped, so CMake
never invokes Cargo and the recipe passes CARGO_EXECUTABLE=/bin/true.

Upstream-Status: Inappropriate [OpenNOW-specific build integration]
---
diff --git a/opennow-qt/cmake/NativeRuntime.cmake b/opennow-qt/cmake/NativeRuntime.cmake
index 3a90d8b3..b5f11edc 100644
--- a/opennow-qt/cmake/NativeRuntime.cmake
+++ b/opennow-qt/cmake/NativeRuntime.cmake
@@ -1,6 +1,14 @@
-set(OPENNOW_CORE_TARGET_DIR "${CMAKE_BINARY_DIR}/rust-target")
-set(OPENNOW_CORE_PROFILE "$<IF:$<CONFIG:Release>,release,debug>")
 set(OPENNOW_CORE_SUFFIX "$<IF:$<PLATFORM_ID:Windows>,.exe,>")
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    # OpenSTLinux ships the Rust artifacts already cross-compiled by the
+    # opennow-runtime recipe into OPENNOW_PREBUILT_NATIVE_DIR. CMake must not
+    # invoke Cargo again: it would target the build host, not the device.
+    set(OPENNOW_CORE_TARGET_DIR "${OPENNOW_PREBUILT_NATIVE_DIR}")
+    set(OPENNOW_CORE_PROFILE "")
+else()
+    set(OPENNOW_CORE_TARGET_DIR "${CMAKE_BINARY_DIR}/rust-target")
+    set(OPENNOW_CORE_PROFILE "$<IF:$<CONFIG:Release>,release,debug>")
+endif()
 if(APPLE)
     if(OPENNOW_PACKAGE_ARCH STREQUAL "arm64")
         set(OPENNOW_MACOS_RUST_TARGET "aarch64-apple-darwin")
@@ -19,7 +27,19 @@ if(OPENNOW_RUST_TARGET)
     set(OPENNOW_CORE_ARTIFACT_ROOT
         "${OPENNOW_CORE_TARGET_DIR}/${OPENNOW_RUST_TARGET}")
 endif()
-add_custom_target(opennow-core ALL
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    add_custom_target(opennow-core ALL
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+            "${OPENNOW_PREBUILT_NATIVE_DIR}/opennow-core${OPENNOW_CORE_SUFFIX}"
+            "$<TARGET_FILE_DIR:opennow-qt>/opennow-core${OPENNOW_CORE_SUFFIX}"
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+            "${OPENNOW_PREBUILT_NATIVE_DIR}/opennow-acceptance-verify${OPENNOW_CORE_SUFFIX}"
+            "$<TARGET_FILE_DIR:opennow-qt>/opennow-acceptance-verify${OPENNOW_CORE_SUFFIX}"
+    COMMENT "Bundling the prebuilt OpenNOW application core"
+    VERBATIM
+)
+else()
+    add_custom_target(opennow-core ALL
     COMMAND "${CMAKE_COMMAND}" -E env
             "OPENNOW_UPDATE_ED25519_PUBLIC_KEY=${OPENNOW_UPDATE_ED25519_PUBLIC_KEY}"
             "OPENNOW_BUILD_VERSION=${OPENNOW_BUILD_VERSION}"
@@ -41,10 +61,20 @@ add_custom_target(opennow-core ALL
     COMMAND_EXPAND_LISTS
     VERBATIM
 )
+endif()
 add_dependencies(opennow-qt opennow-core)
 
 set(OPENNOW_GENERATED_NOTICES "${CMAKE_BINARY_DIR}/THIRD_PARTY_NOTICES.generated")
-add_custom_target(opennow-license-notices ALL
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    add_custom_target(opennow-license-notices ALL
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+            "${OPENNOW_PREBUILT_NATIVE_DIR}/THIRD_PARTY_NOTICES.generated"
+            "${OPENNOW_GENERATED_NOTICES}"
+    COMMENT "Bundling the prebuilt Rust license notices"
+    VERBATIM
+)
+else()
+    add_custom_target(opennow-license-notices ALL
     COMMAND "${CARGO_EXECUTABLE}" build
             --manifest-path "${CMAKE_CURRENT_SOURCE_DIR}/../native/opennow-core/Cargo.toml"
             --target-dir "${OPENNOW_CORE_TARGET_DIR}"
@@ -63,6 +93,7 @@ add_custom_target(opennow-license-notices ALL
     COMMAND_EXPAND_LISTS
     VERBATIM
 )
+endif()
 add_dependencies(opennow-qt opennow-license-notices)
 
 set(OPENNOW_STREAMER_TARGET_DIR "${CMAKE_BINARY_DIR}/streamer-rust-target" CACHE PATH
@@ -72,12 +103,17 @@ if(OPENNOW_RUST_TARGET)
     set(OPENNOW_STREAMER_ARTIFACT_ROOT
         "${OPENNOW_STREAMER_TARGET_DIR}/${OPENNOW_RUST_TARGET}")
 endif()
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    set(OPENNOW_STREAMER_TARGET_DIR "${OPENNOW_PREBUILT_NATIVE_DIR}")
+    set(OPENNOW_STREAMER_ARTIFACT_ROOT "${OPENNOW_PREBUILT_NATIVE_DIR}")
+endif()
 # The embedded streamer decodes and publishes GPU frames in process. A debug
 # Rust build is too slow for real-time playback, so link its release library
 # into every Qt configuration.
-set(OPENNOW_STREAMER_PROFILE "release")
-set(OPENNOW_STREAMER_CARGO_FEATURE_ARGS)
-if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+if(NOT OPENNOW_PREBUILT_NATIVE_DIR)
+    set(OPENNOW_STREAMER_PROFILE "release")
+    set(OPENNOW_STREAMER_CARGO_FEATURE_ARGS)
+    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
     # Distributable Linux builds carry FFmpeg's H.264/HEVC/AV1 software
     # fallback and native H.264 VAAPI with host-provided GPU drivers. Every Qt
     # configuration now shares one cargo profile directory, so this feature has
@@ -91,6 +127,7 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
         OR (NOT OPENNOW_RUST_TARGET AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$"))
         pkg_check_modules(OPENNOW_V4L2_REQUEST REQUIRED libdrm libudev)
     endif()
+    endif()
 endif()
 set(OPENNOW_RUST_EFFECTIVE_TARGET "${OPENNOW_RUST_TARGET}")
 if(WIN32 AND NOT OPENNOW_RUST_EFFECTIVE_TARGET)
@@ -117,7 +154,16 @@ if(WIN32)
     set(OPENNOW_UPDATE_HELPER_ENV --unset=CARGO_ENCODED_RUSTFLAGS
         "RUSTFLAGS=-C target-feature=+crt-static")
 endif()
-add_custom_target(opennow-update-helper-build ALL
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    add_custom_target(opennow-update-helper-build ALL
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+            "${OPENNOW_PREBUILT_NATIVE_DIR}/opennow-update-helper${OPENNOW_CORE_SUFFIX}"
+            "$<TARGET_FILE_DIR:opennow-qt>/opennow-update-helper${OPENNOW_CORE_SUFFIX}"
+    COMMENT "Bundling the prebuilt OpenNOW update helper"
+    VERBATIM
+)
+else()
+    add_custom_target(opennow-update-helper-build ALL
     COMMAND "${CMAKE_COMMAND}" -E env ${OPENNOW_UPDATE_HELPER_ENV}
             "OPENNOW_UPDATE_ED25519_PUBLIC_KEY=${OPENNOW_UPDATE_ED25519_PUBLIC_KEY}"
             "OPENNOW_BUILD_VERSION=${OPENNOW_BUILD_VERSION}"
@@ -137,6 +183,7 @@ add_custom_target(opennow-update-helper-build ALL
 if(NOT WIN32)
     add_dependencies(opennow-update-helper-build opennow-core)
 endif()
+endif()
 add_dependencies(opennow-qt opennow-update-helper-build)
 
 # The Rust target determines its import-library format, not the Qt compiler.
@@ -203,6 +250,14 @@ set(OPENNOW_STREAMER_FFI_LINK_LIBRARY
 set(OPENNOW_STREAMER_FFI_ARTIFACTS
     "${OPENNOW_STREAMER_FFI_RUNTIME}" "${OPENNOW_STREAMER_FFI_LINK_LIBRARY}")
 list(REMOVE_DUPLICATES OPENNOW_STREAMER_FFI_ARTIFACTS)
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    # Link against copies staged in the CMake build directory so ninja owns
+    # the artifacts; the source stays the prebuilt directory installed by the
+    # opennow-runtime recipe.
+    set(OPENNOW_STREAMER_FFI_RUNTIME "${CMAKE_BINARY_DIR}/${OPENNOW_STREAMER_FFI_RUNTIME_NAME}")
+    set(OPENNOW_STREAMER_FFI_LINK_LIBRARY "${OPENNOW_STREAMER_FFI_RUNTIME}")
+    set(OPENNOW_STREAMER_FFI_ARTIFACTS "${OPENNOW_STREAMER_FFI_RUNTIME}")
+endif()
 set(OPENNOW_STREAMER_FFI_CARGO_COMMAND build)
 set(OPENNOW_STREAMER_FFI_RUSTC_ARGS)
 if(APPLE)
@@ -212,7 +267,17 @@ endif()
 file(GLOB_RECURSE OPENNOW_STREAMER_RUST_SOURCES CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_SOURCE_DIR}/../native/opennow-streamer/crates/*.rs"
     "${CMAKE_CURRENT_SOURCE_DIR}/../native/opennow-streamer/crates/*/Cargo.toml")
-add_custom_command(
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    add_custom_command(
+        OUTPUT ${OPENNOW_STREAMER_FFI_ARTIFACTS}
+        COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+                "${OPENNOW_PREBUILT_NATIVE_DIR}/${OPENNOW_STREAMER_FFI_RUNTIME_NAME}"
+                "${OPENNOW_STREAMER_FFI_RUNTIME}"
+        COMMENT "Bundling the prebuilt OpenNOW streamer library"
+        VERBATIM
+    )
+else()
+    add_custom_command(
     OUTPUT ${OPENNOW_STREAMER_FFI_ARTIFACTS}
     COMMAND "${CMAKE_COMMAND}" -E env --unset=MAKEFLAGS --unset=MFLAGS
             "CMAKE=${CMAKE_COMMAND}"
@@ -235,6 +300,7 @@ add_custom_command(
     COMMAND_EXPAND_LISTS
     VERBATIM
 )
+endif()
 add_custom_target(opennow-streamer-ffi-build
     DEPENDS ${OPENNOW_STREAMER_FFI_ARTIFACTS})
 
@@ -249,7 +315,18 @@ else()
 endif()
 set(OPENNOW_STREAMER_BIN_ARTIFACT
     "${OPENNOW_STREAMER_ARTIFACT_ROOT}/${OPENNOW_STREAMER_PROFILE}/${OPENNOW_STREAMER_BIN_NAME}")
-add_custom_command(
+if(OPENNOW_PREBUILT_NATIVE_DIR)
+    set(OPENNOW_STREAMER_BIN_ARTIFACT "${OPENNOW_PREBUILT_NATIVE_DIR}/${OPENNOW_STREAMER_BIN_NAME}")
+    add_custom_command(
+    OUTPUT "${OPENNOW_STREAMER_BIN_ARTIFACT}"
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+            "${OPENNOW_PREBUILT_NATIVE_DIR}/${OPENNOW_STREAMER_BIN_NAME}"
+            "${OPENNOW_STREAMER_BIN_ARTIFACT}"
+    COMMENT "Bundling the prebuilt OpenNOW streamer executable"
+    VERBATIM
+)
+else()
+    add_custom_command(
     OUTPUT "${OPENNOW_STREAMER_BIN_ARTIFACT}"
     COMMAND "${CMAKE_COMMAND}" -E env --unset=MAKEFLAGS --unset=MFLAGS
             "CMAKE=${CMAKE_COMMAND}"
@@ -270,6 +347,7 @@ add_custom_command(
     COMMAND_EXPAND_LISTS
     VERBATIM
 )
+endif()
 add_custom_target(opennow-streamer-bin-build ALL
     DEPENDS "${OPENNOW_STREAMER_BIN_ARTIFACT}")
 add_dependencies(opennow-qt opennow-streamer-bin-build)
-- 
2.43.0
