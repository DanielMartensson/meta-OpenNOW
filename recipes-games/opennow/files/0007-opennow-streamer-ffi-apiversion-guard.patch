From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Watermelon OS <build@watermelon-wine-1a>
Date: Sun, 13 Sep 2026 19:30:00 +0200
Subject: [PATCH] streamer: never surface apiVersion 0 across the FFI boundary

SharedVulkanDevice::info() returned the raw api_version field, which can be 0 for
a device that could not query the Vulkan API version. The Qt shell adopts this
value into VkApplicationInfo::apiVersion; a zero is rejected by Qt and drops OpenNOW
to software rendering despite working hardware Vulkan 1.3. Report the lowest API the
embedded pipeline is compiled against (VK_API_VERSION_1_1) instead of 0.

The guard is written against the Vulkan API version directly and is driver- and
vendor-agnostic, so it applies to every OpenNOW deployment, not only embedded SoCs.

---
diff --git a/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/vulkan_device.rs b/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/vulkan_device.rs
index 0a440e33..1528e5ab 100644
--- a/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/vulkan_device.rs
+++ b/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/vulkan_device.rs
@@ -48,7 +48,15 @@ impl SharedVulkanDevice {
     }
 
     pub fn info(&self) -> VulkanDeviceInfo {
-        self.info
+        let mut info = self.info;
+        // Never let the FFI boundary report apiVersion 0: Qt rejects a zero
+        // VkApplicationInfo::apiVersion and drops to software rendering. Clamp
+        // to the lowest API the adopted pipeline is built against, regardless
+        // of the underlying driver or vendor.
+        if info.api_version == 0 {
+            info.api_version = ash::vk::API_VERSION_1_1;
+        }
+        info
     }
 
     pub fn codec_support(&self, codec: VideoCodec, ten_bit: bool) -> bool {
